{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skillOverrides": {
    "code-review": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'python3 ~/.claude/session-memory-hook.py 2>>~/.claude/session-memory-hook.log || python ~/.claude/session-memory-hook.py 2>>~/.claude/session-memory-hook.log'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash ~/.claude/toast.sh \"Response complete\"'",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'python3 ~/.claude/memory-sync-hook.py 2>>~/.claude/memory-sync-hook.log || python ~/.claude/memory-sync-hook.py 2>>~/.claude/memory-sync-hook.log'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'python3 ~/.claude/doc-sync-hook.py 2>/dev/null || python ~/.claude/doc-sync-hook.py 2>/dev/null || { case \"$(uname -s)\" in MINGW*|MSYS*|CYGWIN*) exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File ~/.claude/doc-sync-hook.ps1 ;; esac; }'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'python3 ~/.claude/stuck-loop-hook.py 2>>~/.claude/stuck-loop-hook.log || python ~/.claude/stuck-loop-hook.py 2>>~/.claude/stuck-loop-hook.log'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'python3 ~/.claude/pre-push-doc-sync-hook.py 2>>~/.claude/pre-push-doc-sync-hook.log || python ~/.claude/pre-push-doc-sync-hook.py 2>>~/.claude/pre-push-doc-sync-hook.log || true'"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash ~/.claude/toast.sh \"Question waiting\"'",
            "async": true
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash ~/.claude/toast.sh \"Plan ready\"'",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'python3 -S ~/.claude/statusline.py 2>/dev/null || python -S ~/.claude/statusline.py 2>/dev/null || powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ~/.claude/statusline.ps1'"
  },
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": true,
    "playwright@claude-plugins-official": true,
    "telegram@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
